# Motion Sense (Oslo): com.google.oslo, a SystemUI plugin APK in system_ext.
# Rules that need vendor types live in vendor/google/floral_oslo_app.te.

app_domain(floral_oslo_app)

allow floral_oslo_app fwk_stats_hwservice:hwservice_manager find;
allow floral_oslo_app fwk_stats_service:service_manager find;
binder_call(floral_oslo_app, statsd)
binder_use(floral_oslo_app)

allow floral_oslo_app app_api_service:service_manager find;
allow floral_oslo_app audioserver_service:service_manager find;
allow floral_oslo_app mediaserver_service:service_manager find;
allow floral_oslo_app radio_service:service_manager find;

# /mnt/vendor/persist/oslo
typeattribute floral_oslo_app system_writes_mnt_vendor_violators;
allow floral_oslo_app mnt_vendor_file:dir search;
