<?xml version='1.0' encoding='utf-8'?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.hecker.floral.motionsense" android:versionCode="1" android:versionName="1.0" android:sharedUserId="android.uid.system">
    <queries>
        <package android:name="com.google.android.gms" />
        <package android:name="com.google.android.gsf" />
        <package android:name="com.google.android.euicc" />
        <package android:name="com.google.euiccpixel" />
        <package android:name="com.google.android.ims" />
        <package android:name="com.google.oslo" />
